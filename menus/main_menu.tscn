[sub_resource type="GDScript" id="GDScript_wl6xk"]
resource_name = "crt_menu"
script/source = "extends MeshInstance3D

# TODO: handle cursor motion
@onready var ORIGIN := position
@onready var ORIENTATION := rotation_degrees

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	var t = Time.get_ticks_msec() / 1000.0
	position = ORIGIN + Vector3(
		cos(t * 1.4 / 2) * 0.05,
		sin(t * 1.4) * 0.075,
		0.0
	)
	rotation_degrees = ORIENTATION + Vector3(
		cos(t * 0.3) * 2,
		0.0,
		sin(t * 0.66) * 4
	)
"

